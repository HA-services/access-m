<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_axsync_access" model="ir.module.category">
        <field name="name">User Access Control</field>
        <field name="sequence">90</field>
    </record>

    <record id="group_axsync_access_manager" model="res.groups">
        <field name="name">Access Control Manager</field>
        <field name="category_id" ref="module_category_axsync_access"/>
        <field name="comment">Can create and change access control rules. Members are never restricted by the rules, so they cannot lock themselves out.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_axsync_access_manager'))]"/>
    </record>
</odoo>
