<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="axsync_res_users_view_form" model="ir.ui.view">
        <field name="name">res.users.form.axsync.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Access Control" name="axsync_access" groups="axsync_user_access_control.group_axsync_access_manager">
                    <group>
                        <field name="axsync_manager_id" options="{'no_create': True}"/>
                    </group>
                    <p class="text-muted">The user chosen here can see this user's records when a record rule uses "Own and Subordinates".</p>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
